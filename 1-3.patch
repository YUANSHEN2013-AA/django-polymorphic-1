+                        real_ct_id = real_obj.polymorphic_ctype_id
+                        expected_ct_ids = class_to_ct_ids.get(cls, set())
+                        if real_ct_id not in expected_ct_ids:
+                            real_cls = ct_id_to_class.get(real_ct_id)
