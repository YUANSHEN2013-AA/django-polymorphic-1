+class TestProjectPolymorphic(TransactionTestCase):
+
+    def setUp(self):
+        super().setUp()
+        self.project = Project.objects.create(topic="General Topic")
+        self.art_project = ArtProject.objects.create(
+            topic="Art Topic", artist="Vincent van Gogh"
+        )
+        self.research_project = ResearchProject.objects.create(
+            topic="Research Topic", supervisor="Dr. Smith"
+        )
+
+    def test_polymorphic_queryset_returns_correct_types(self):
+        qs = Project.objects.all().order_by("id")
+        objects = list(qs)
+        assert len(objects) == 3
+        assert isinstance(objects[0], Project)
+        assert not isinstance(objects[0], ArtProject)
+        assert not isinstance(objects[0], ResearchProject)
+        assert isinstance(objects[1], ArtProject)
+        assert isinstance(objects[2], ResearchProject)
+
+    def test_non_polymorphic_queryset_returns_base_type(self):
+        qs = Project.objects.all().non_polymorphic().order_by("id")
+        objects = list(qs)
+        assert len(objects) == 3
+        for obj in objects:
+            assert type(obj) is Project
+
+    def test_get_real_instance_base_model(self):
+        o = Project.objects.non_polymorphic().get(topic="General Topic")
+        real = o.get_real_instance()
+        assert type(real) is Project
+
+    def test_get_real_instance_child_model(self):
+        o = Project.objects.non_polymorphic().get(topic="Art Topic")
+        real = o.get_real_instance()
+        assert isinstance(real, ArtProject)
+        assert real.artist == "Vincent van Gogh"
+
+    def test_get_real_instance_grandchild_not_applicable(self):
+        o = Project.objects.non_polymorphic().get(topic="Research Topic")
+        real = o.get_real_instance()
+        assert isinstance(real, ResearchProject)
+        assert real.supervisor == "Dr. Smith"
+
+    def test_get_real_instances_from_queryset(self):
+        qs = Project.objects.all().non_polymorphic().order_by("id")
+        objects = Project.objects.get_real_instances(qs)
+        assert len(objects) == 3
+        assert type(objects[0]) is Project
+        assert isinstance(objects[1], ArtProject)
+        assert isinstance(objects[2], ResearchProject)
+
+    def test_get_real_instances_empty_list(self):
+        objects = Project.objects.get_real_instances([])
+        assert objects == []
+
+    def test_instance_of_single_model(self):
+        qs = Project.objects.filter(instance_of=ArtProject)
+        objects = list(qs)
+        assert len(objects) == 1
+        assert isinstance(objects[0], ArtProject)
+
+    def test_instance_of_multiple_models(self):
+        qs = Project.objects.filter(instance_of=(ArtProject, ResearchProject)).order_by("id")
+        objects = list(qs)
+        assert len(objects) == 2
+        assert isinstance(objects[0], ArtProject)
+        assert isinstance(objects[1], ResearchProject)
+
+    def test_instance_of_base_model(self):
+        qs = Project.objects.filter(instance_of=Project).order_by("id")
+        objects = list(qs)
+        assert len(objects) == 3
+
+    def test_instance_of_via_translate_polymorphic_q_object(self):
+        q = Project.translate_polymorphic_Q_object(Q(instance_of=ArtProject))
+        objects = list(Project.objects.filter(q))
+        assert len(objects) == 1
+        assert isinstance(objects[0], ArtProject)
+
+    def test_delete_child_keep_parents(self):
+        art_pk = self.art_project.pk
+        project_pk = self.art_project.project_ptr_id
+
+        self.art_project.delete(keep_parents=True)
+
+        assert ArtProject.objects.filter(pk=art_pk).count() == 0
+        assert Project.objects.filter(pk=project_pk).count() == 1
+        parent = Project.objects.get(pk=project_pk)
+        assert type(parent) is Project
+
+    def test_delete_child_without_keep_parents_cascades(self):
+        art_pk = self.art_project.pk
+        project_pk = self.art_project.project_ptr_id
+
+        self.art_project.delete()
+
+        assert ArtProject.objects.filter(pk=art_pk).count() == 0
+        assert Project.objects.filter(pk=project_pk).count() == 0
+
+    def test_roundtrip_create_art_project_retrieve_as_parent(self):
+        art = ArtProject.objects.create(topic="Roundtrip Art", artist="Picasso")
+        parent = Project.objects.non_polymorphic().get(pk=art.pk)
+        assert type(parent) is Project
+        assert parent.topic == "Roundtrip Art"
+        real = parent.get_real_instance()
+        assert isinstance(real, ArtProject)
+        assert real.artist == "Picasso"
+
+    def test_roundtrip_create_research_project_retrieve_as_parent(self):
+        research = ResearchProject.objects.create(
+            topic="Roundtrip Research", supervisor="Dr. Jones"
+        )
+        parent = Project.objects.non_polymorphic().get(pk=research.pk)
+        real = parent.get_real_instance()
+        assert isinstance(real, ResearchProject)
+        assert real.supervisor == "Dr. Jones"
+
+    def test_roundtrip_polymorphic_query_after_keep_parents_delete(self):
+        art = ArtProject.objects.create(topic="Pre-delete Art", artist="Dali")
+        art_pk = art.pk
+
+        art.delete(keep_parents=True)
+
+        qs = list(Project.objects.all().order_by("id"))
+        assert len(qs) == 4
+        parent_from_qs = [o for o in qs if o.pk == art_pk][0]
+        assert type(parent_from_qs) is Project
+        assert parent_from_qs.topic == "Pre-delete Art"
+
+    def test_get_real_instance_class(self):
+        o = ArtProject.objects.create(topic="Class test", artist="Monet")
+        parent = Project.objects.non_polymorphic().get(pk=o.pk)
+        real_class = parent.get_real_instance_class()
+        assert real_class is ArtProject
+
+    def test_get_real_concrete_instance_class(self):
+        o = ArtProject.objects.create(topic="Concrete class", artist="Rembrandt")
+        parent = Project.objects.non_polymorphic().get(pk=o.pk)
+        concrete_class = parent.get_real_concrete_instance_class()
+        assert concrete_class is ArtProject
+
+    def test_get_real_concrete_instance_class_id(self):
+        o = ArtProject.objects.create(topic="Class ID test", artist="Klimt")
+        parent = Project.objects.non_polymorphic().get(pk=o.pk)
+        class_id = parent.get_real_concrete_instance_class_id()
+        assert class_id == ContentType.objects.get_for_model(ArtProject).pk
+
+    def test_project_str(self):
+        p = Project.objects.create(topic="Str test")
+        assert str(p) is not None
+
+    def test_art_project_str(self):
+        a = ArtProject.objects.create(topic="Art str", artist="Goya")
+        assert str(a) is not None
+
+    def test_research_project_str(self):
+        r = ResearchProject.objects.create(topic="Research str", supervisor="Dr. Who")
+        assert str(r) is not None
+
+    def test_polymorphic_ctype_is_set(self):
+        p = Project.objects.create(topic="CT test")
+        assert p.polymorphic_ctype_id is not None
+        assert p.polymorphic_ctype == ContentType.objects.get_for_model(Project)
+
+    def test_child_polymorphic_ctype_correct(self):
+        a = ArtProject.objects.create(topic="Child CT", artist="Munch")
+        assert a.polymorphic_ctype == ContentType.objects.get_for_model(ArtProject)
+
