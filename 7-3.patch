+class TestUUIDModelPolymorphic(TransactionTestCase):
+
+    def setUp(self):
+        super().setUp()
+        self.a = UUIDModelA.objects.create(
+            uuid_primary_key=uuid.uuid4(), field1="A-field1"
+        )
+        self.b = UUIDModelB.objects.create(
+            uuid_primary_key=uuid.uuid4(), field1="B-field1", field2="B-field2"
+        )
+        self.c = UUIDModelC.objects.create(
+            uuid_primary_key=uuid.uuid4(),
+            field1="C-field1",
+            field2="C-field2",
+            field3="C-field3",
+        )
+
+    def test_polymorphic_queryset_returns_correct_types(self):
+        qs = UUIDModelA.objects.all().order_by("field1")
+        objects = list(qs)
+        assert len(objects) == 3
+        assert isinstance(objects[0], UUIDModelA)
+        assert not isinstance(objects[0], UUIDModelB)
+        assert isinstance(objects[1], UUIDModelB)
+        assert not isinstance(objects[1], UUIDModelC)
+        assert isinstance(objects[2], UUIDModelC)
+
+    def test_uuid_primary_key_is_correct_type(self):
+        assert isinstance(self.a.pk, uuid.UUID)
+        assert isinstance(self.b.pk, uuid.UUID)
+        assert isinstance(self.c.pk, uuid.UUID)
+
+    def test_get_real_instance_uuid_base(self):
+        o = UUIDModelA.objects.non_polymorphic().get(pk=self.a.pk)
+        real = o.get_real_instance()
+        assert type(real) is UUIDModelA
+        assert real.field1 == "A-field1"
+
+    def test_get_real_instance_uuid_child_b(self):
+        o = UUIDModelA.objects.non_polymorphic().get(pk=self.b.pk)
+        real = o.get_real_instance()
+        assert isinstance(real, UUIDModelB)
+        assert real.field2 == "B-field2"
+
+    def test_get_real_instance_uuid_child_c(self):
+        o = UUIDModelA.objects.non_polymorphic().get(pk=self.c.pk)
+        real = o.get_real_instance()
+        assert isinstance(real, UUIDModelC)
+        assert real.field3 == "C-field3"
+
+    def test_instance_of_uuid_b(self):
+        qs = UUIDModelA.objects.filter(instance_of=UUIDModelB)
+        objects = list(qs)
+        assert len(objects) == 2
+        for obj in objects:
+            assert isinstance(obj, UUIDModelB)
+
+    def test_instance_of_uuid_c(self):
+        qs = UUIDModelA.objects.filter(instance_of=UUIDModelC)
+        objects = list(qs)
+        assert len(objects) == 1
+        assert isinstance(objects[0], UUIDModelC)
+
+    def test_instance_of_uuid_multiple(self):
+        qs = UUIDModelA.objects.filter(
+            instance_of=(UUIDModelB, UUIDModelC)
+        ).order_by("field1")
+        objects = list(qs)
+        assert len(objects) == 3
+        assert isinstance(objects[0], UUIDModelB)
+        assert isinstance(objects[1], UUIDModelB)
+        assert isinstance(objects[2], UUIDModelC)
+
+    def test_delete_child_b_keep_parents(self):
+        b_pk = self.b.pk
+        b_uuid_ptr = self.b.uuidmodela_ptr_id
+
+        self.b.delete(keep_parents=True)
+
+        assert UUIDModelB.objects.filter(pk=b_pk).count() == 0
+        parent = UUIDModelA.objects.get(pk=b_uuid_ptr)
+        assert type(parent) is UUIDModelA
+        assert parent.field1 == "B-field1"
+
+    def test_delete_child_c_keep_parents(self):
+        c_pk = self.c.pk
+        c_uuid_ptr = self.c.uuidmodela_ptr_id
+
+        self.c.delete(keep_parents=True)
+
+        assert UUIDModelC.objects.filter(pk=c_pk).count() == 0
+        parent = UUIDModelA.objects.get(pk=c_uuid_ptr)
+        assert type(parent) is UUIDModelA
+        assert parent.field1 == "C-field1"
+
+    def test_delete_child_b_without_keep_parents_cascades(self):
+        b_pk = self.b.pk
+        b_uuid_ptr = self.b.uuidmodela_ptr_id
+
+        self.b.delete()
+
+        assert UUIDModelB.objects.filter(pk=b_pk).count() == 0
+        assert UUIDModelA.objects.filter(pk=b_uuid_ptr).count() == 0
+
+    def test_roundtrip_uuid_create_child_retrieve_as_base(self):
+        child = UUIDModelC.objects.create(
+            uuid_primary_key=uuid.uuid4(),
+            field1="RT-field1",
+            field2="RT-field2",
+            field3="RT-field3",
+        )
+        base = UUIDModelA.objects.non_polymorphic().get(pk=child.pk)
+        assert type(base) is UUIDModelA
+        real = base.get_real_instance()
+        assert isinstance(real, UUIDModelC)
+        assert real.field1 == "RT-field1"
+        assert real.field2 == "RT-field2"
+        assert real.field3 == "RT-field3"
+
+    def test_roundtrip_polymorphic_after_keep_parents(self):
+        child = UUIDModelB.objects.create(
+            uuid_primary_key=uuid.uuid4(), field1="KP-field1", field2="KP-field2"
+        )
+        child_pk = child.pk
+        child.delete(keep_parents=True)
+
+        qs = list(UUIDModelA.objects.all().order_by("field1"))
+        parent = [o for o in qs if o.pk == child_pk][0]
+        assert type(parent) is UUIDModelA
+        assert parent.field1 == "KP-field1"
+
