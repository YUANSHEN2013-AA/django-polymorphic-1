+        qs = ProxyA.objects.all()
+        objects = list(qs)
+        assert len(objects) == 1
+        assert isinstance(objects[0], ProxyA)
+        assert objects[0].title == "Proxy A Title"
+
+    def test_proxy_b_queryset_only_returns_b(self):
+        qs = ProxyB.objects.all()
+        objects = list(qs)
+        assert len(objects) == 1
