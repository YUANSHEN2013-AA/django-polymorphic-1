+++ b/src/polymorphic/static/polymorphic/css/polymorphic_type_select.css
@@ -0,0 +1,238 @@
+.polymorphic-type-select {
+    padding: 10px 0;
+}
+
+.polymorphic-type-select__panel {
+    background: var(--body-bg, #fff);
+    border: 1px solid var(--border-color, #ccc);
+    border-radius: 4px;
+    overflow: hidden;
+}
+
+.polymorphic-type-select__header {
+    padding: 12px 16px;
+    border-bottom: 1px solid var(--border-color, #ccc);
+    background: var(--darkened-bg, #f8f8f8);
+}
+
+.polymorphic-type-select__title {
+    margin: 0;
+    font-size: 14px;
+    font-weight: 600;
+    color: var(--body-fg, #333);
+}
+
+.polymorphic-type-select__search {
+    padding: 12px 16px;
+    border-bottom: 1px solid var(--border-color, #ccc);
+}
+
+.polymorphic-type-select__search-input {
+    width: 100%;
+    padding: 8px 12px;
+    border: 1px solid var(--border-color, #ccc);
+    border-radius: 4px;
+    font-size: 13px;
+    box-sizing: border-box;
+    background: var(--body-bg, #fff);
+    color: var(--body-fg, #333);
+}
+
+.polymorphic-type-select__search-input:focus {
+    border-color: var(--primary, #79aec8);
+    outline: none;
+    box-shadow: 0 0 0 2px rgba(121, 174, 200, 0.25);
+}
+
+.polymorphic-type-select__tabs {
+    display: flex;
+    border-bottom: 1px solid var(--border-color, #ccc);
+    padding: 0 12px;
+    background: var(--darkened-bg, #f8f8f8);
+}
+
+.polymorphic-type-select__tab {
+    padding: 8px 16px;
+    border: none;
+    background: none;
+    cursor: pointer;
+    font-size: 12px;
+    font-weight: 500;
+    color: var(--body-quiet-color, #666);
+    border-bottom: 2px solid transparent;
+    transition: color 0.15s, border-color 0.15s;
+}
+
+.polymorphic-type-select__tab:hover {
+    color: var(--body-fg, #333);
+}
+
+.polymorphic-type-select__tab.active {
+    color: var(--primary, #79aec8);
+    border-bottom-color: var(--primary, #79aec8);
+}
+
+.polymorphic-type-select__categories {
+    max-height: 380px;
+    overflow-y: auto;
+    padding: 8px 16px;
+}
+
+.polymorphic-type-select__loading {
+    padding: 24px;
+    text-align: center;
+    color: var(--body-quiet-color, #666);
+    font-size: 13px;
+}
+
+.polymorphic-type-select__spinner {
+    display: inline-block;
+    width: 16px;
+    height: 16px;
+    border: 2px solid var(--border-color, #ccc);
+    border-top-color: var(--primary, #79aec8);
+    border-radius: 50%;
+    animation: polymorphic-spin 0.6s linear infinite;
+    margin-right: 8px;
+    vertical-align: middle;
+}
+
+@keyframes polymorphic-spin {
+    to { transform: rotate(360deg); }
+}
+
+.polymorphic-type-select__empty,
+.polymorphic-type-select__error {
+    padding: 32px 16px;
+    text-align: center;
+    color: var(--body-quiet-color, #666);
+    font-size: 13px;
+}
+
+.polymorphic-type-select__error {
+    color: var(--error-fg, #ba2121);
+}
+
+.polymorphic-type-select__category {
+    margin-bottom: 8px;
+}
+
+.polymorphic-type-select__category-name {
+    font-size: 11px;
+    font-weight: 600;
+    text-transform: uppercase;
+    letter-spacing: 0.5px;
+    color: var(--body-quiet-color, #999);
+    margin: 12px 0 4px 0;
+    padding: 0;
+}
+
+.polymorphic-type-select__type-list {
+    display: flex;
+    flex-direction: column;
+    gap: 2px;
+}
+
+.polymorphic-type-select__type-item {
+    display: flex;
+    align-items: center;
+    justify-content: space-between;
+    padding: 8px 12px;
+    border: 1px solid transparent;
+    border-radius: 4px;
+    cursor: pointer;
+    transition: background 0.15s, border-color 0.15s;
+}
+
+.polymorphic-type-select__type-item:hover {
+    background: var(--selected-row, #f2f9fc);
+    border-color: var(--primary, #79aec8);
+}
+
+.polymorphic-type-select__type-item.is-selected {
+    background: var(--selected-bg, #e4f0f5);
+    border-color: var(--primary, #79aec8);
+    font-weight: 500;
