+
+.polymorphic-type-select__type-item.is-favorite .polymorphic-type-select__fav-btn {
+    color: #e8b830;
+}
+
+.polymorphic-type-select__submit {
+    margin-top: 12px;
+    padding: 0 !important;
+    background: none !important;
