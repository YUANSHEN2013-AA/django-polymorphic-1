+{% block extrahead %}
+{{ block.super }}
+<style>
+  #polymorphic-type-selector {
+    max-width: 800px;
+    margin: 20px auto;
+    font-family: sans-serif;
+  }
+  .search-bar {
+    margin-bottom: 20px;
+  }
+  .search-bar input {
+    width: 100%;
+    padding: 10px;
+    font-size: 16px;
+    border: 1px solid #ccc;
+    border-radius: 4px;
+    box-sizing: border-box;
+  }
+  .category-section {
+    margin-bottom: 20px;
+    background: #fff;
+    border: 1px solid #ddd;
+    border-radius: 4px;
+    overflow: hidden;
+  }
+  .category-section h2 {
+    margin: 0;
+    padding: 10px 15px;
+    background: #f8f8f8;
+    border-bottom: 1px solid #ddd;
+    font-size: 16px;
+    color: #333;
+  }
+  .type-list {
+    list-style: none;
+    margin: 0;
+    padding: 0;
+  }
+  .type-item {
+    display: flex;
+    justify-content: space-between;
+    align-items: center;
+    padding: 10px 15px;
+    border-bottom: 1px solid #eee;
+    transition: background-color 0.2s;
+  }
+  .type-item:last-child {
+    border-bottom: none;
+  }
+  .type-item:hover {
+    background-color: #f1f1f1;
+  }
+  .type-link {
+    text-decoration: none;
+    color: #447e9b;
+    font-weight: bold;
+    flex-grow: 1;
+    display: block;
+  }
+  .type-link:hover {
+    color: #036;
+  }
+  .fav-btn {
+    background: none;
+    border: none;
+    cursor: pointer;
+    font-size: 20px;
+    color: #ccc;
+    outline: none;
+  }
+  .fav-btn.active {
+    color: #ffb400;
+  }
+  #loading-spinner {
+    text-align: center;
+    padding: 20px;
+    font-size: 16px;
+    color: #666;
+  }
+  .hidden {
+    display: none !important;
+  }
+</style>
+{% endblock %}
+
+{% block breadcrumbs %}
+<div class="breadcrumbs">
+<a href="{% url 'admin:index' %}">{% translate 'Home' %}</a>
+&rsaquo; <a href="{% url 'admin:app_list' app_label=app_label %}">{{ app_label|capfirst|escape }}</a>
+&rsaquo; <a href="{% url opts|admin_urlname:'changelist' %}">{{ opts.verbose_name_plural|capfirst }}</a>
+&rsaquo; {% translate 'Add' %} {{ opts.verbose_name }}
+</div>
+{% endblock %}
+
+{% block content %}
+<div id="content-main">
+  <h1>{% translate 'Select type to add' %}</h1>
+  
+  <div id="polymorphic-type-selector">
+    <div class="search-bar">
+      <input type="text" id="type-search" placeholder="Search subclasses..." autocomplete="off" />
+    </div>
+    
+    <div id="loading-spinner">Loading types...</div>
+    
+    <div id="type-lists" class="hidden">
+      <div id="recent-container" class="category-section hidden">
+        <h2>Recently Used</h2>
+        <ul class="type-list" id="recent-list"></ul>
+      </div>
+      
+      <div id="favorites-container" class="category-section hidden">
+        <h2>Favorites</h2>
+        <ul class="type-list" id="favorites-list"></ul>
+      </div>
+      
+      <div id="categories-container">
+        <!-- Categories will be injected here -->
+      </div>
+    </div>
+  </div>
+</div>
 
-{% block submit_buttons_bottom %}
-  {% include 'admin/submit_line.html' with show_save=1 %}
+<script>
+document.addEventListener('DOMContentLoaded', function() {
+    const asyncUrl = "{{ async_choices_url|escapejs }}";
+    const extraQs = "{{ request.META.QUERY_STRING|escapejs }}";
+    const storageKeyPrefix = "polymorphic_" + "{{ opts.app_label }}_{{ opts.model_name }}_";
+    const favKey = storageKeyPrefix + "favorites";
+    const recentKey = storageKeyPrefix + "recent";
+    
+    let allChoices = [];
+    let favorites = JSON.parse(localStorage.getItem(favKey) || "[]");
+    let recent = JSON.parse(localStorage.getItem(recentKey) || "[]");
+    
+    const searchInput = document.getElementById('type-search');
+    const loadingSpinner = document.getElementById('loading-spinner');
+    const typeLists = document.getElementById('type-lists');
+    const categoriesContainer = document.getElementById('categories-container');
+    const favoritesContainer = document.getElementById('favorites-container');
+    const favoritesList = document.getElementById('favorites-list');
+    const recentContainer = document.getElementById('recent-container');
+    const recentList = document.getElementById('recent-list');
+    
+    function saveFavorites() {
+        localStorage.setItem(favKey, JSON.stringify(favorites));
+    }
+    
+    function saveRecent() {
+        localStorage.setItem(recentKey, JSON.stringify(recent));
+    }
+    
+    function addRecent(id) {
+        recent = recent.filter(r => r !== id);
+        recent.unshift(id);
+        if (recent.length > 5) recent = recent.slice(0, 5);
+        saveRecent();
+    }
+    
+    function toggleFavorite(id) {
+        if (favorites.includes(id)) {
+            favorites = favorites.filter(f => f !== id);
+        } else {
+            favorites.push(id);
+        }
+        saveFavorites();
+        render();
+    }
+    
+    function createTypeItem(choice) {
+        const li = document.createElement('li');
+        li.className = 'type-item';
+        
+        const a = document.createElement('a');
+        a.className = 'type-link';
+        a.textContent = choice.name;
+        
+        let targetUrl = "?ct_id=" + choice.id;
+        if (extraQs) {
+            targetUrl += "&" + extraQs;
+        }
+        a.href = targetUrl;
+        
+        a.addEventListener('click', function() {
+            addRecent(choice.id);
+        });
+        
+        const favBtn = document.createElement('button');
+        favBtn.className = 'fav-btn' + (favorites.includes(choice.id) ? ' active' : '');
+        favBtn.innerHTML = '★';
+        favBtn.title = favorites.includes(choice.id) ? "Remove from favorites" : "Add to favorites";
+        favBtn.addEventListener('click', function(e) {
+            e.preventDefault();
+            toggleFavorite(choice.id);
+        });
+        
+        li.appendChild(a);
+        li.appendChild(favBtn);
+        return li;
+    }
+    
+    function render() {
+        const query = searchInput.value.toLowerCase().trim();
+        
+        // Filter choices
+        const filtered = allChoices.filter(c => c.name.toLowerCase().includes(query));
+        
+        // Render Favorites
+        favoritesList.innerHTML = '';
+        const favChoices = filtered.filter(c => favorites.includes(c.id));
+        if (favChoices.length > 0 && !query) {
+            favoritesContainer.classList.remove('hidden');
+            favChoices.forEach(c => favoritesList.appendChild(createTypeItem(c)));
+        } else {
+            favoritesContainer.classList.add('hidden');
+        }
+        
+        // Render Recent
+        recentList.innerHTML = '';
+        const recentChoices = recent.map(id => filtered.find(c => c.id === id)).filter(Boolean);
+        if (recentChoices.length > 0 && !query) {
+            recentContainer.classList.remove('hidden');
+            recentChoices.forEach(c => recentList.appendChild(createTypeItem(c)));
+        } else {
+            recentContainer.classList.add('hidden');
+        }
+        
+        // Render Categories
+        categoriesContainer.innerHTML = '';
+        const byCategory = {};
+        filtered.forEach(c => {
+            if (!byCategory[c.category]) byCategory[c.category] = [];
+            byCategory[c.category].push(c);
+        });
+        
+        Object.keys(byCategory).sort().forEach(cat => {
+            const section = document.createElement('div');
+            section.className = 'category-section';
+            
+            const h2 = document.createElement('h2');
+            h2.textContent = cat;
+            section.appendChild(h2);
+            
+            const ul = document.createElement('ul');
+            ul.className = 'type-list';
+            byCategory[cat].forEach(c => {
+                ul.appendChild(createTypeItem(c));
+            });
+            section.appendChild(ul);
+            
+            categoriesContainer.appendChild(section);
+        });
+    }
+    
+    searchInput.addEventListener('input', render);
+    
+    // Fetch choices
+    fetch(asyncUrl)
+        .then(response => response.json())
+        .then(data => {
+            allChoices = data.choices;
+            loadingSpinner.classList.add('hidden');
+            
+            if (allChoices.length === 1) {
+                // Auto redirect if only one choice
+                let targetUrl = "?ct_id=" + allChoices[0].id;
+                if (extraQs) targetUrl += "&" + extraQs;
+                window.location.href = targetUrl;
+                return;
+            }
+            
+            typeLists.classList.remove('hidden');
+            render();
+        })
+        .catch(error => {
+            console.error('Error fetching type choices:', error);
+            loadingSpinner.textContent = 'Error loading types. Please try again.';
+        });
+});
+</script>
 {% endblock %}
